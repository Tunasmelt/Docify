SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
VOYAGE_API_KEY=
GEMINI_API_KEY=
# FEAT-017 OCR fallback tier 2 (OCR.space, independent vendor from Gemini).
# Real key goes in .env only, never committed — same discipline as every
# other credential above. The public "helloworld" demo key (500 req/day
# per IP, no registration) works for ad hoc verification but isn't meant
# for real use — see .agent/api-docs/ocrspace.md.
OCR_SPACE_API_KEY=
# FEAT-017 tier 3 (Tesseract, self-hosted last resort). Optional — only
# needed to point at a tesseract binary that isn't already on PATH (e.g.
# local Windows dev). Docker/Linux production leaves this unset; the
# apt-get-installed binary is already on PATH there.
TESSERACT_CMD=
